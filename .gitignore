# ─────────────────────────────────────────────────────────────
# Secrets & environment  (NEVER commit real env files)
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json

# ─────────────────────────────────────────────────────────────
# Python / backend (uv)
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
.python-version

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.cache/

# Coverage / test artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# NOTE: commit uv.lock and pyproject.toml — do not ignore them.

# ─────────────────────────────────────────────────────────────
# Node / frontend (pnpm + Quasar + Vite)
# ─────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.quasar/
frontend/.vite/
.vite/
.eslintcache
*.tsbuildinfo
.vue-tsc/

# NOTE: commit pnpm-lock.yaml — do not ignore it.

# ─────────────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# ─────────────────────────────────────────────────────────────
# Local data, dumps & GIS downloads  (keep large/raw data out of git)
# Test fixtures belong under */tests/ and are intentionally not ignored.
# ─────────────────────────────────────────────────────────────
/data/
/backend/data/*
# ...but keep the documented sample corpus and its README in git
!/backend/data/title14/
/backend/data/title14/*
!/backend/data/title14/README.md
!/backend/data/title14/sections.sample.jsonl
!/backend/data/title14/sections.jsonl
!/backend/data/demo/
/backend/data/demo/*
!/backend/data/zoning-hbg/
/backend/data/zoning-hbg/*
!/backend/data/zoning-hbg/sections.jsonl
!/backend/data/demo/demo.sql
tmp/
scratch/
*.dump
*.sql.gz
*.tar.gz
*.zip
*.7z

# Shapefile component binaries (download to /data, don't commit)
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Local model / embedding artifacts (embeddings live in pgvector, not git)
/models/
*.gguf
*.onnx

# ─────────────────────────────────────────────────────────────
# Docker (commit compose files; ignore local volume mounts)
# ─────────────────────────────────────────────────────────────
.docker/
docker-data/
pgdata/

# ─────────────────────────────────────────────────────────────
# Infrastructure (Terraform)
# ─────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!example.tfvars

# ─────────────────────────────────────────────────────────────
# Editors / IDEs
# ─────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo

# ─────────────────────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

mynotes.txt
# Flattened whole-repo text dumps (repo-to-text tooling); regenerate, never commit
lotscope.txt
# Corpus source binaries + raw GIS pulls (parsed into JSONL/DB; never commit the raw data)
backend/corpus/**/*.pdf
backend/corpus/**/*.json
backend/corpus/**/*.geojson
backend/corpus/**/*.csv
sync-db.sh
# Gold-set evidence may be licensed, private, or owner-confidential; only the
# synthetic sample belongs in the repository. The directory must be re-included
# before the file can be, because /backend/data/* above excludes its parent.
!/backend/data/goldset/
/backend/data/goldset/*
!/backend/data/goldset/phl-sample.jsonl
backend/data/packets/
