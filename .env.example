APP_ENV=local
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-env

POSTGRES_USER=lotscope
POSTGRES_PASSWORD=lotscope
POSTGRES_DB=lotscope

DATABASE_URL=postgresql+asyncpg://lotscope:lotscope@localhost:5432/lotscope
REDIS_URL=redis://localhost:6379/0
MARTIN_URL=http://localhost:3000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

VOYAGE_API_KEY=
VOYAGE_URL=https://api.voyageai.com/v1/embeddings
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024

CARTO_SQL_URL=https://phl.carto.com/api/v2/sql
ARCGIS_HUB_URL=https://data-phl.opendata.arcgis.com
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=0.5

REGRID_API_TOKEN=
STRIPE_API_KEY=
