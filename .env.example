APP_ENV=local
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-env
# GIT_SHA is injected by scripts/deploy.sh (git rev-parse HEAD) and surfaced at
# /health and on the admin ops page; the deploy drift-guard compares it. Leave unset locally.

POSTGRES_USER=lotscope
POSTGRES_PASSWORD=lotscope
POSTGRES_DB=lotscope

DATABASE_URL=postgresql+asyncpg://lotscope:lotscope@localhost:5432/lotscope
REDIS_URL=redis://localhost:6379/0
MARTIN_URL=http://localhost:3000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5-20251001

VOYAGE_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_RETRIES=5
VOYAGE_URL=https://api.voyageai.com/v1/embeddings
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024
PHILADOX_DOCUMENT_URL_TEMPLATE=https://epay.phila-records.com/phillyepay/web/integration/document/InstrumentID={document_id}&Guest=true

GOOGLE_MAPS_API_KEY=

DEAL_CONSTRUCTION_COST_PER_SQFT=175
DEAL_SOFT_COST_PCT=0.15
DEAL_SELLING_COST_PCT=0.07
DEAL_TARGET_MARGIN=0.20
DEAL_DEFAULT_UNIT_SQFT=1200
DEAL_MAX_UNIT_SQFT=3000

CARTO_SQL_URL=https://phl.carto.com/api/v2/sql
ARCGIS_HUB_URL=https://data-phl.opendata.arcgis.com
SHERIFF_SALE_SOURCE=csv
SHERIFF_SALE_CSV_PATH=
SHERIFF_SALE_COUNTY_ID=60
SHERIFF_SALE_CIVILVIEW_BASE_URL=https://salesweb.civilview.com
SHERIFF_SALE_CIVILVIEW_REQUEST_DELAY_SECONDS=0.5
SHERIFF_SALE_CIVILVIEW_DETAIL_LIMIT=
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=0.5
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

REGRID_API_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_LEGACY=
# Founding-member offer: a distinct $49/mo Stripe price locked for life, mapped to the pro tier.
# Blank = no founding offer shown. Cap closes at FOUNDING_CAP active subs OR FOUNDING_CUTOFF (ISO date),
# whichever first. FOUNDING_PRICE_MONTHLY_CENTS is display-only for the pricing page.
STRIPE_PRICE_PRO_FOUNDING=
FOUNDING_CAP=50
FOUNDING_CUTOFF=
FOUNDING_PRICE_MONTHLY_CENTS=4900
STRIPE_PRICE_INVESTOR_MONTHLY=
STRIPE_PRICE_INVESTOR_ANNUAL=
STRIPE_PRICE_CREDITS_25=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_APPEAL_PACKET=
# Skip trace. Blank = dormant (endpoint returns "not available yet"). Set PROVIDER=batchdata + API_KEY
# to go live (ADR-0060). CACHE_TTL_DAYS=30 satisfies BatchData's cache-refresh clause; "null" provider
# (returns no contacts) is for local/dev testing without a paid key.
SKIPTRACE_PROVIDER=
SKIPTRACE_API_KEY=
SKIPTRACE_API_URL=https://api.batchdata.com/api/v1/property/skip-trace
SKIPTRACE_CACHE_TTL_DAYS=30
BILLING_SUCCESS_URL=http://localhost:5173/account?checkout=success
BILLING_CANCEL_URL=http://localhost:5173/account?checkout=cancel
BILLING_PORTAL_RETURN_URL=http://localhost:5173/account
ENTERPRISE_CONTACT_URL=mailto:sales@parcelphl.online

# Email. Local dev points at the Mailpit mail-catcher that `make up` starts —
# captured mail is viewable at http://localhost:8025 and nothing leaves your
# machine. Leave SMTP_HOST blank to disable email entirely (get_email_sender
# returns None). In production, swap for a real provider with no code change,
# e.g. Mailgun: SMTP_HOST=smtp.mailgun.org SMTP_PORT=587
# SMTP_USER=postmaster@<domain> SMTP_PASSWORD=<key> SMTP_USE_TLS=true.
# (If you run the backend inside the docker `app` profile, use SMTP_HOST=mailpit.)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=alerts@parcelphl.online
EMAIL_FROM_NAME=LotScope PHL
# Optional Reply-To for user-facing mail (blank = replies go to EMAIL_FROM).
EMAIL_REPLY_TO=
# Staged-rollout gate. Comma/JSON list of recipient addresses; when NON-EMPTY,
# mail to any address NOT listed is suppressed (logged, no send). Empty = send to
# everyone. Use it to flip email on for your own inbox first, then clear to go live.
# e.g. EMAIL_ALLOWLIST=["owner@parcelphl.online"]
EMAIL_ALLOWLIST=[]
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
COMPANY_POSTAL_ADDRESS="LotScope PHL, Philadelphia, PA"

# Web push (generate with: make vapid-keys)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:alerts@lotscope.app
